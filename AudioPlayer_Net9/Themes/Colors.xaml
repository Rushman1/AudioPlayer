<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Primary Colors -->

	<SolidColorBrush x:Key="PrimaryBackgroundBrush"
	                 Color="#202020"/>

	<SolidColorBrush x:Key="SecondaryBackgroundBrush"
	                 Color="#2B2B2B"/>

	<SolidColorBrush x:Key="TertiaryBackgroundBrush"
	                 Color="#3A3A3A"/>

	<!-- Accent -->

	<SolidColorBrush x:Key="AccentBrush"
	                 Color="#0A84FF"/>

	<SolidColorBrush x:Key="AccentHoverBrush"
	                 Color="#399CFF"/>

	<!-- Text -->

	<SolidColorBrush x:Key="PrimaryTextBrush"
	                 Color="White"/>

	<SolidColorBrush x:Key="SecondaryTextBrush"
	                 Color="#CCCCCC"/>

	<SolidColorBrush x:Key="MutedTextBrush"
	                 Color="#888888"/>

	<!-- Borders -->

	<SolidColorBrush x:Key="BorderBrush"
	                 Color="#444444"/>

</ResourceDictionary>