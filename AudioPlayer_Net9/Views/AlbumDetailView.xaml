<UserControl x:Class="AudioPlayer_Net9.Views.AlbumDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AudioPlayer_Net9.Views"
             xmlns:models="clr-namespace:AudioPlayer_Net9.Models"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
	    <Grid.RowDefinitions>
		    <RowDefinition Height="250"></RowDefinition>
		    <RowDefinition Height="*"></RowDefinition>
	    </Grid.RowDefinitions>

	    <!-- Header Info -->
		<Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
	    <Grid>
		    <Grid.ColumnDefinitions>
			    <ColumnDefinition Width="210"></ColumnDefinition>
			    <ColumnDefinition Width="*"></ColumnDefinition>
		    </Grid.ColumnDefinitions>
		    <!-- Header Image -->
		    <Border Width="195"
		             Height="195"
		             Grid.Column="0"
								 CornerRadius="10"
		             HorizontalAlignment="Left"
		             VerticalAlignment="Center">
					<Border.Background>
						<ImageBrush ImageSource="{Binding Album.AlbumArt}" Stretch="UniformToFill"></ImageBrush>
					</Border.Background>
		    </Border>
				<!-- Header Album Information -->
		    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
			    <TextBlock Name="AlbumName" Text="{Binding Album.Name}" FontWeight="Bold" FontSize="32" Foreground="White"></TextBlock>
			    <TextBlock Name="ArtistName" Text="{Binding Album.Artist}" FontSize="18" Foreground="White" Margin="0,15"></TextBlock>
				<TextBlock Name="AlbumInfo" Text="{Binding AlbumInfo}" FontSize="14" Foreground="#88ffffff"/>
			</StackPanel>
	    </Grid>
		</Border>
	    <!-- Track List -->

		<ListBox Grid.Row="1" ItemsSource="{Binding TracksView}"
		         Background="Transparent" 
						 HorizontalContentAlignment="Stretch"
		         BorderThickness="0" Margin="15,0"
		         ScrollViewer.VerticalScrollBarVisibility="Hidden"
		         ScrollViewer.HorizontalScrollBarVisibility="Hidden">
			<ListBox.ItemContainerStyle>
				<Style TargetType="ListBoxItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<Border x:Name="ItemBorder" CornerRadius="6" Background="Transparent" Padding="5,10,10,10">
									<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
								</Border>
								<ControlTemplate.Triggers>
									<DataTrigger Binding="{Binding IsAlternateRow}" Value="True">
										<Setter TargetName="ItemBorder" Property="Background" Value="#202020"></Setter>
									</DataTrigger>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="ItemBorder" Property="Background" Value="#333333"></Setter>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ListBox.ItemContainerStyle>
			<ListBox.ItemTemplate>
				<DataTemplate DataType="{x:Type models:Track}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="20"/>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<!-- Action Icons -->
						<StackPanel Grid.Column="0" Orientation="Horizontal">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Setter Property="Opacity" Value="0"></Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
											<Setter Property="Opacity" Value="1"></Setter>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>
							<CheckBox VerticalAlignment="Center"/>
							<Button Style="{StaticResource NavigationButtonStyle}" Foreground="White">
								<iconPacks:PackIconMaterial Kind="Play" />
							</Button>
							<Button Style="{StaticResource NavigationButtonStyle}" 
								        Foreground="White"
								        Command="{Binding DataContext.EditTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
								<iconPacks:PackIconMaterial Kind="Pencil" />
							</Button>
						</StackPanel>
						<TextBlock Grid.Column="1" Text="{Binding TrackNumber, StringFormat={}{0}. }" TextAlignment="Right" Foreground="White" />
						<TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="White" Margin="6, 0, 0, 0" />
						<TextBlock Grid.Column="3" Text="{Binding Artist}" Foreground="White" />
						<TextBlock Grid.Column="4" Text="{Binding Year}" TextAlignment="Right" Margin="0,0,20,0" Foreground="White"/>
						<TextBlock Grid.Column="5" Text="{Binding Genre}" Foreground="White" />
						<TextBlock Grid.Column="6" Text="{Binding DurationDisplay}" Foreground="White" Margin="0,0,20,0" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

	</Grid>
</UserControl>
