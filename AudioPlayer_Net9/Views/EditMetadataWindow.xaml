<Window x:Class="AudioPlayer_Net9.Views.EditMetadataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Metadata"
    Height="450"
    Width="400"
    WindowStartupLocation="CenterOwner">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<TextBlock Grid.Row="0" Text="Title:"/>
		<TextBox Grid.Row="0"
                 Grid.Column="1"
								 Margin="10,5"
                 Text="{Binding Title}"/>

		<TextBlock Grid.Row="1" Text="Artist:"/>
		<TextBox Grid.Row="1"
                 Grid.Column="1"
								 Margin="10,5"
                 Text="{Binding Artist}"/>

		<TextBlock Grid.Row="2" Text="Album:"/>
		<TextBox Grid.Row="2"
                 Grid.Column="1"
								 Margin="10,5"
                 Text="{Binding Album}"/>

		<TextBlock Grid.Row="3" Text="Genre:"/>
		<TextBox Grid.Row="3"
                 Grid.Column="1"
								 Margin="10, 5"
                 Text="{Binding Genre}"/>

		<TextBlock Grid.Row="4" Text="Year:"/>
		<TextBox Grid.Row="4"
                 Grid.Column="1"
								 Margin="10,5"
                 Text="{Binding Year}"/>

		<TextBlock Grid.Row="5" Text="Track #:"/>
		<TextBox Grid.Row="5"
                 Grid.Column="1"
								 Margin="10,5"
                 Text="{Binding TrackNumber}"/>
		<TextBlock Grid.Row="6" Grid.Column="0" Text="Cover:"></TextBlock>
		<Grid Grid.Row="6" Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"></RowDefinition>
				<RowDefinition Height="35"></RowDefinition>
			</Grid.RowDefinitions>
			<Image Source="{Binding AlbumArt}"
			       Width="100"
			       Height="100"
			       Stretch="Uniform"
			       Grid.Row="0"></Image>
			<Button Content="Change cover" Command="{Binding ChangeCoverCommand}" Height="35" FontSize="11" Grid.Row="1"></Button>
		</Grid>


		<StackPanel Grid.Row="7"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

			<Button
			        Content="Save"
			        HorizontalAlignment="Center"
			        Height="35"
			        Width="100"
			        Command="{Binding SaveCommand}"/>
		</StackPanel>

	</Grid>

</Window>