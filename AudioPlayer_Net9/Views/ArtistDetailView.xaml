<UserControl x:Class="AudioPlayer_Net9.Views.ArtistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AudioPlayer_Net9.Views"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="250"></RowDefinition>
			<RowDefinition Height="*"></RowDefinition>
		</Grid.RowDefinitions>

		<!-- Header Info -->
		<Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="210"></ColumnDefinition>
					<ColumnDefinition Width="*"></ColumnDefinition>
				</Grid.ColumnDefinitions>

				<!-- Header Image -->
				<Ellipse Width="195"
				         Height="195"
				         Grid.Column="0"
				         Margin="5"
				         HorizontalAlignment="Center"
				         VerticalAlignment="Center">
					<Ellipse.Fill>
						<ImageBrush ImageSource="{Binding Artist.ImagePath}" Stretch="UniformToFill" />
					</Ellipse.Fill>
				</Ellipse>
				<!-- Header Artist Information -->
				<StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10,0, 0,0">
					<TextBlock Name="ArtistName" Text="{Binding Artist.Name}" FontWeight="Bold" FontSize="32" Foreground="White" Margin="0, 10"></TextBlock>
					<TextBlock Name="ArtistInfo" Text="{Binding ArtistInfo}" FontSize="18" Foreground="White"></TextBlock>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Album List -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
		              Margin="15,0,0,0">
			<ItemsControl ItemsSource="{Binding Albums}">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button
							Command="{Binding DataContext.SelectAlbumCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
							CommandParameter="{Binding}"
							Style="{StaticResource ArtistAlbumTrackButtonStyle}">
							<StackPanel>
								<Border Width="210"
								        Height="240"
								        Padding="5">
									<StackPanel>
										<!-- Album Art -->
										<Border Width="180"
										        Height="180"
										        ClipToBounds="True"
										        CornerRadius="10">
											<Border.Background>
												<ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill"></ImageBrush>
											</Border.Background>
										</Border>
										<!-- Album Name -->
										<TextBlock Text="{Binding Name}"
										           FontWeight="Bold"
										           Foreground="White"
										           Margin="10,8,0,0"
										           TextWrapping="Wrap"
															 FontSize="15"
										           TextAlignment="Left" />
										<!-- Year -->
										<TextBlock Text="{Binding Year}"
										           Foreground="Gray"
										           Margin="10,0,0,0"
															 FontSize="12"
										           HorizontalAlignment="Left" />
									</StackPanel>
								</Border>
							</StackPanel>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>