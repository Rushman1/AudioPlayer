<UserControl x:Class="AudioPlayer_Net9.Views.ArtistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AudioPlayer_Net9.Views"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="150"></RowDefinition>
			<RowDefinition Height="*"></RowDefinition>
		</Grid.RowDefinitions>

		<!-- Header Info -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="130"></ColumnDefinition>
				<ColumnDefinition Width="*"></ColumnDefinition>
			</Grid.ColumnDefinitions>
			<!-- Header Image -->
			<Ellipse Width="100"
			         Height="100"
			         Grid.Column="0"
							 Margin="15,0,0,0"
			         HorizontalAlignment="Left"
			         VerticalAlignment="Center">
				<Ellipse.Fill>
					<ImageBrush ImageSource="{Binding Artist.ImagePath}" Stretch="UniformToFill" />
				</Ellipse.Fill>
			</Ellipse>
			<StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
				<TextBlock Name="ArtistName" Text="{Binding Artist.Name}" FontWeight="Bold" FontSize="24" Foreground="White"></TextBlock>
				<TextBlock Name="ArtistInfo" Text="{Binding ArtistInfo}" FontSize="18" Foreground="White"></TextBlock>
			</StackPanel>
		</Grid>

		<!-- Album List -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Margin="15,0,0,0">
			<ItemsControl ItemsSource="{Binding Albums}">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button
							Command="{Binding DataContext.SelectAlbumCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
							CommandParameter="{Binding}"
							Style="{StaticResource ArtistAlbumTrackButtonStyle}">
							<StackPanel>
								<Border Width="120"
								        Height="160"
								        Padding="5">
									<StackPanel>
										<!-- Album Art -->
										<Border Width="100"
										        Height="100"
										        ClipToBounds="True"
										        CornerRadius="10">
											<Image Source="{Binding AlbumArt}"
														 Height="100"
														 Width="100"
											       Stretch="UniformToFill" />
										</Border>
										<!-- Album Name -->
										<TextBlock Text="{Binding Name}"
										           FontWeight="Bold"
										           Foreground="White"
										           Margin="5,8,0,0"
										           TextWrapping="Wrap"
										           TextAlignment="Left" />
										<!-- Year -->
										<TextBlock Text="{Binding Year}"
										           Foreground="Gray"
															 Margin="5,0,0,0"
										           HorizontalAlignment="Left" />
									</StackPanel>
								</Border>
							</StackPanel>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>