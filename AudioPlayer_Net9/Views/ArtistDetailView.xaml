<UserControl x:Class="AudioPlayer_Net9.Views.ArtistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AudioPlayer_Net9.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
	<ScrollViewer VerticalScrollBarVisibility="Auto">

		<StackPanel>

			<!-- Artist Image -->

			<Image Source="{Binding Artist.ImagePath}"
               Height="300"
               Stretch="UniformToFill"/>

			<!-- Artist Name -->

			<TextBlock Text="{Binding Artist.Name}"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="10"/>

			<!-- Albums -->

			<ItemsControl ItemsSource="{Binding Albums}">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>

						<Border Width="180"
                            Margin="10"
                            Padding="5">

							<StackPanel>

								<!-- Album Art -->

								<Border Width="160"
                                    Height="160"
                                    CornerRadius="5">

									<Image Source="{Binding AlbumArt}"
                                       Stretch="UniformToFill"/>
								</Border>

								<!-- Album Name -->

								<TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

								<!-- Year -->

								<TextBlock Text="{Binding Year}"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"/>

							</StackPanel>

						</Border>

					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</StackPanel>

	</ScrollViewer>
</UserControl>